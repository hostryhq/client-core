{
  "name": "@hostry/client-core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared non-UI client TypeScript for Hostry apps: generated API types, local store, sync client, auth, device adapters",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/sync/lan-node.d.ts",
      "import": "./dist/sync/lan-node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:api": "node scripts/sync-api-types.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
